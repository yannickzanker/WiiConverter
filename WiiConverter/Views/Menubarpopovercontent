import SwiftUI
import AppKit

/// Erscheint beim Klick auf das Menüleisten-Icon — wie das Dropdown von
/// WLAN/Batterie/Wetter. Zeigt großen Fortschritts-Ring, Status, letzte
/// Log-Zeile und Kurzbefehle (Fenster öffnen, Einstellungen, Beenden).
struct MenuBarPopoverContent: View {
    @ObservedObject var converter: Converter
    @Environment(\.openWindow) private var openWindow

    private var progress: Double {
        converter.progressTotal > 0 ? Double(converter.progressDone) / Double(converter.progressTotal) : 0
    }

    var body: some View {
        VStack(alignment: .leading, spacing: 14) {
            HStack(spacing: 12) {
                ZStack {
                    Circle().stroke(DS.border, lineWidth: 5)
                    if converter.progressTotal > 0 {
                        Circle()
                            .trim(from: 0, to: progress)
                            .stroke(DS.accent, style: StrokeStyle(lineWidth: 5, lineCap: .round))
                            .rotationEffect(.degrees(-90))
                            .animation(.easeOut(duration: 0.25), value: progress)
                    }
                    Text(converter.progressTotal > 0 ? "\(Int(progress * 100))%" : "–")
                        .font(.system(size: 13, weight: .semibold))
                        .foregroundColor(DS.textPrimary)
                }
                .frame(width: 52, height: 52)

                VStack(alignment: .leading, spacing: 2) {
                    Text("WiiConverter")
                        .font(.system(size: 14, weight: .bold))
                        .foregroundColor(DS.textPrimary)
                    Text(statusText)
                        .font(.system(size: 12))
                        .foregroundColor(DS.textSecondary)
                }
            }

            if let last = converter.log.last {
                Text(last.message)
                    .font(DS.mono(11))
                    .foregroundColor(DS.textSecondary)
                    .lineLimit(2)
            }

            Rectangle().fill(DS.border).frame(height: 1)

            VStack(spacing: 2) {
                menuRow(icon: "macwindow", title: "Fenster öffnen") {
                    openWindow(id: "main")
                    NSApp.activate(ignoringOtherApps: true)
                }
                menuRow(icon: "gearshape", title: "Einstellungen…") {
                    NSApp.sendAction(Selector(("showSettingsWindow:")), to: nil, from: nil)
                    NSApp.activate(ignoringOtherApps: true)
                }
                menuRow(icon: "power", title: "Beenden") {
                    NSApp.terminate(nil)
                }
            }
        }
        .padding(16)
        .frame(width: 260)
        .background(DS.panelBG)
    }

    private var statusText: String {
        if converter.isRunning {
            return "\(converter.progressDone)/\(converter.progressTotal) konvertiert"
        } else if converter.progressTotal > 0 {
            return "Fertig — \(converter.progressDone)/\(converter.progressTotal)"
        } else {
            return "Bereit"
        }
    }

    private func menuRow(icon: String, title: String, action: @escaping () -> Void) -> some View {
        Button(action: action) {
            HStack(spacing: 8) {
                Image(systemName: icon)
                    .font(.system(size: 12))
                    .frame(width: 16)
                Text(title)
                    .font(.system(size: 12))
                Spacer()
            }
            .foregroundColor(DS.textPrimary)
            .padding(.horizontal, 10)
            .padding(.vertical, 7)
            .contentShape(Rectangle())
        }
        .buttonStyle(MenuRowButtonStyle())
    }
}

struct MenuRowButtonStyle: ButtonStyle {
    func makeBody(configuration: Configuration) -> some View {
        configuration.label
            .background(configuration.isPressed ? DS.hoverFill : Color.clear)
            .clipShape(RoundedRectangle(cornerRadius: DS.radiusControl, style: .continuous))
    }
}
